# === Fleet Route Optimizer - Backend Environment ===

# Database
DATABASE_URL=postgresql+asyncpg://fleet:fleet@localhost:5432/fleet_optimizer

# Redis
REDIS_URL=redis://localhost:6379/0

# Waze Integration
WAZE_API_KEY=your_waze_api_key_here
WAZE_API_URL=https://www.waze.com/live-map/api
WAZE_POLLING_INTERVAL_SECONDS=30

# Route Optimization
MAX_DELIVERIES_PER_DRIVER=20
RE_ROUTE_ON_INCIDENT_SEVERITY=3
DEFAULT_SPEED_KMH=40.0

# App
DEBUG=true
SECRET_KEY=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=480
